# ── Serbian Transcriber backend configuration ─────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_key_here

# Port the server listens on
PORT=3000

# Maximum accepted upload size in megabytes.
# NOTE: the Groq free tier accepts files up to 25 MB (dev tier: 100 MB).
# Keep this at or below 25 unless your Groq tier allows more.
MAX_FILE_SIZE_MB=25

# Comma-separated list of origins allowed to call this API (CORS).
# Example for a GitHub Pages frontend:
# https://your-username.github.io,https://your-username.github.io/serbian-transcriber
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io

# Whisper model to use. whisper-large-v3-turbo (fast) or whisper-large-v3 (highest accuracy).
GROQ_MODEL=whisper-large-v3-turbo

# Optional: path to an ffmpeg binary. If set, the backend can extract the
# audio track from large video files and also accept .mov files.
# Example: /usr/bin/ffmpeg  (or empty to disable ffmpeg support)
FFMPEG_PATH=

# Set to "true" in production so cookies/redirects behave correctly.
NODE_ENV=development
