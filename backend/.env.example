# ── Serbian Transcriber backend configuration ─────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_key_here

# Port the server listens on
PORT=3000

# Size of the file we SEND to Groq. This is the Groq tier limit:
# 25 MB on the free tier, 100 MB on the dev tier. The server refuses to send
# anything bigger and tells the user clearly instead of failing silently.
MAX_FILE_SIZE_MB=25

# Largest video the browser may upload to this server (before conversion).
# Anything above MAX_FILE_SIZE_MB — and every .mov file — is converted to
# compact mono 16 kHz audio when ffmpeg is available. Raise it only if your
# host has disk space and a generous request-body limit.
MAX_UPLOAD_MB=500

# Comma-separated list of origins allowed to call this API (CORS).
# Note: no path, no trailing slash — just the origin.
ALLOWED_ORIGINS=https://dexilio13-ui.github.io,http://localhost:8080

# Whisper model: whisper-large-v3-turbo (fast, cheaper) or whisper-large-v3 (highest accuracy).
GROQ_MODEL=whisper-large-v3-turbo

# Absolute path to ffmpeg. Required for .mov and large uploads.
# The Docker image ships ffmpeg, so this is already set there.
# On a plain host: install ffmpeg and point this at it, e.g. /usr/bin/ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# Send only the audio track to the transcription API (recommended).
# The API never needs pictures: this keeps the payload tiny and works
# for every video codec (HEVC/H.265 from iPhones, VP9/AV1 from Android).
# Set to false to forward small MP4s untouched for slightly less server CPU.
ALWAYS_EXTRACT_AUDIO=true

# Optional safety valves
# GROQ_TIMEOUT_MS=120000     # abort the Groq call after this long
# FFMPEG_TIMEOUT_MS=300000    # abort audio conversion after this long
# LOG_LEVEL=info              # info | warn | error

NODE_ENV=development